# ─── GramAI Backend Environment Configuration ───────────────────────────────

# ── LLM Provider (choose one) ──────────────────────────────────────────────
# Google Gemini (recommended)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# OpenAI alternative
# OPENAI_API_KEY=your_openai_api_key_here

# LLM Model name
LLM_MODEL=gemini-1.5-flash

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://gramai:gramai_pass@localhost:5432/gramai_db
# For SQLite (simpler local dev):
# DATABASE_URL=sqlite:///./gramai.db

# ── JWT Auth ───────────────────────────────────────────────────────────────
SECRET_KEY=your_super_secret_jwt_key_change_this_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── ChromaDB ───────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── External APIs ──────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── App Settings ───────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_SIZE_MB=10

# ── Voice Settings ─────────────────────────────────────────────────────────
WHISPER_MODEL=base
TTS_ENGINE=gtts
